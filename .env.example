# demo = tout est simulé ; live = vrais prestataires (seuls les moyens configurés sont proposés)
MODE=demo
PORT=3000
PUBLIC_URL=https://votre-domaine.com
ADMIN_TOKEN=changez-moi-long-et-aleatoire

# Grille de frais (en euros, convertis en FCFA au taux fixe pour les envois depuis le Gabon)
# Jusqu'à FEE_SMALL_LIMIT_EUR : prix d'appel FEE_SMALL_EUR. Au-delà : FEE_FIXED_EUR + FEE_PERCENT %.
FEE_SMALL_LIMIT_EUR=50
FEE_SMALL_EUR=0.99
FEE_FIXED_EUR=1.49
FEE_PERCENT=1.5
FEE_PAYPAL_SURCHARGE_PERCENT=1.0
# Premier envoi : frais offerts jusqu'à ce montant
FIRST_TRANSFER_FREE_MAX_EUR=5
MIN_AMOUNT_EUR=5
MAX_AMOUNT_EUR=1000

# Airtel Africa Open API (https://developers.airtel.africa) : Collection + Disbursement + KYC, pays GA
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_PUBLIC_KEY=
# UAT : https://openapiuat.airtel.africa  –  Production : https://openapi.airtel.africa
AIRTEL_BASE_URL=https://openapiuat.airtel.africa

# Stripe : paiement par carte (et PayPal via Stripe) pour France -> Gabon
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYPAL_ENABLED=false

# PayPal Payouts : versement sur un compte PayPal pour Gabon -> France
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox : https://api-m.sandbox.paypal.com  –  Production : https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Virements SEPA sortants : nom de votre établissement partenaire, une fois son client branché (src/providers/sepa.js)
SEPA_PROVIDER=
